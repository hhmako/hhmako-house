# Required for Feishu long-connection message events and image resources.
LARK_APP_ID=replace_me
LARK_APP_SECRET=replace_me

# Required when cards are sent through a group webhook.
# Leave empty only when progressBot.chatId is configured and lark-cli is authenticated.
LARK_BOT_WEBHOOK=replace_me

# Optional external semantic analyzer. Built-in strict rules are used when empty.
ISSUE_ANALYZER_COMMAND=
